# Online multiplayer (optional).
#
# Without these two values the game still works: solo play is unaffected, and
# multiplayer falls back to LOCAL mode, which connects browser tabs on this
# same PC (great for testing).
#
# To play with friends over the internet:
#   1. Create a free project at https://supabase.com
#   2. Project Settings -> API
#   3. Copy "Project URL" and the "anon public" key below
#   4. Rename this file to .env and restart `npm run dev`
#
# No database tables, no SQL and no auth are needed - the game only uses
# Supabase Realtime Broadcast, which keeps rooms in memory.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Your own relay server (optional, but the cheapest way to run full rooms).
#
# Supabase bills per message, and a broadcast counts once per recipient, so a
# full room burns the free allowance quickly. The little server in ./server is
# billed by bandwidth instead, which makes the same traffic essentially free.
#
#   1. Deploy ./server (Render free tier works: root directory "server",
#      build "npm install", start "npm start")
#   2. Put the URL below, using wss:// rather than https://
#   3. Rebuild - Vite bakes env vars in at build time
#
# Running it on this machine instead:  cd server && npm start
#   VITE_WS_URL=ws://localhost:8787
#
# When this is set it is used instead of Supabase. Leave it empty to fall
# back to Supabase, or to local browser-tab mode if that is unset too.
VITE_WS_URL=
