# Online multiplayer (optional).
#
# Without these two values the game still works: solo play is unaffected, and
# multiplayer falls back to LOCAL mode, which connects browser tabs on this
# same PC (great for testing).
#
# To play with friends over the internet:
#   1. Create a free project at https://supabase.com
#   2. Project Settings -> API
#   3. Copy "Project URL" and the "anon public" key below
#   4. Rename this file to .env and restart `npm run dev`
#
# No database tables, no SQL and no auth are needed - the game only uses
# Supabase Realtime Broadcast, which keeps rooms in memory.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
